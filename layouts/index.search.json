{{- $entries := slice -}}
{{- $publicationsURL := (site.GetPage "/publications").Permalink -}}
{{- range where site.RegularPages "Section" "ne" "publications" -}}
  {{- $name := .Title -}}
  {{- if eq .Section "members" -}}{{- $name = .Params.name_en | default .Title -}}{{- end -}}
  {{- $entries = $entries | append (dict "title" $name "type" .Section "text" (printf "%s %s %s" .Title (.Params.description | default "") (.Plain | plainify)) "url" .Permalink) -}}
{{- end -}}
{{- range hugo.Data.publications_database -}}
  {{- $text := printf "%s %s %s" .authors .venue_full .tags_raw -}}
  {{- $entries = $entries | append (dict "title" .title "type" "publications" "text" $text "url" (printf "%s#%s" $publicationsURL .id)) -}}
{{- end -}}
{{- $entries | jsonify | safeJS -}}
